{
  "name": "aira-semanticscholar",
  "module": "./build/index.js",
  "version": "1.0.2",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "type": "module",
  "bin": {
    "aira-semanticscholar": "./build/index.js"
  },
  "scripts": {
    "dev": "TRANSPORT=http npx tsx src/index.ts",
    "build": "node --eval \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && npx tsc",
    "prepublishOnly": "npm run build",
    "start": "npm run start:stdio",
    "start:http": "TRANSPORT=http node build/index.js",
    "start:stdio": "node build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "MCP server for Semantic Scholar research workflows with stdio and Streamable HTTP transports.",
  "devDependencies": {
    "@smithery/cli": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@tanstack/react-query": "^5.69.0",
    "@thednp/dommatrix": "^2.0.12",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.0",
    "pdfjs-dist": "^5.4.54",
    "zod": "^3.24.2"
  }
}
